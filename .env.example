# See docs/ENVIRONMENT_VARIABLES.md
# Every value here is EXPO_PUBLIC_* and therefore bundled into the app binary
# and readable by anyone who inspects it. Never put a genuine secret here.
# There are no server secrets in this project because there is no server.

# Exchange rate API (Frankfurter — no API key required)
EXPO_PUBLIC_FX_API_BASE_URL=https://api.frankfurter.dev/v1
EXPO_PUBLIC_FX_API_KEY=

# RevenueCat public SDK keys (from the RevenueCat dashboard)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# NOTE: EXPO_PUBLIC_SENTRY_DSN is intentionally absent. Opt-in crash reporting
# is not shipped in v1 — docs/THIRD_PARTY_INTEGRATIONS.md §5 permits omitting it,
# and user_settings has no column to persist the opt-in choice required by
# docs/ANALYTICS.md. See README.md "Flagged deviations" (G1).
