{
  "expo": {
    "name": "SpendTr",
    "slug": "spendtr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spendtr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/brand/icon-1024-light.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendtr.app",
      "icon": {
        "light": "./assets/brand/icon-1024-light.png",
        "dark": "./assets/brand/icon-1024-dark.png"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "SpendTr uses Face ID to unlock your local expense data on this device. Your data never leaves your phone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spendtr.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#5B5FEF"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SpendTr uses Face ID to unlock your local expense data on this device."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#EA580C"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA",
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0B0F14",
            "image": "./assets/brand/splash-mark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1a6e0a4-0985-4e64-8467-89424ad9c3c5"
      }
    },
    "owner": "bhworkspace",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1a6e0a4-0985-4e64-8467-89424ad9c3c5"
    }
  }
}
