# TypeScript 7 (typescript@^7.0.2, already pinned in package.json before this
# file was added) is newer than the current stable @typescript-eslint peer
# range (<6.1.0). Without this, a plain `npm install` fails with ERESOLVE on
# @typescript-eslint/parser's peer dependency. Verified working at runtime
# via the ts-api-utils override below and a full local test/typecheck run —
# remove this once @typescript-eslint publishes a TS7-compatible peer range.
legacy-peer-deps=true
